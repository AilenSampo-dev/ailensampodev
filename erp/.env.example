# Copiá a .env — local: npm run dev | Vercel: Environment Variables

# ─── Email (Brevo) ───
BREVO_API_KEY=
BREVO_FROM_EMAIL=hola@ailensampo.com
# Copia de cada envío al cliente (casilla Zoho donde querés archivar)
ADMIN_EMAIL=hola@ailensampo.com
# Remitente técnico para copias a hola@ (evita soft bounce). Lo ves en Brevo → Logs, ej. hola@123456.brevosend.com
BREVO_INTERNAL_SENDER=

# ─── Acceso al ERP ───
ERP_PASSWORD=
JWT_SECRET=

# ─── Respaldo en Supabase (requerido para enlace al cliente) ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── URL pública (producción: https://app.ailensampo.com) ───
APP_URL=https://app.ailensampo.com
