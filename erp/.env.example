# Copiá a .env — local: npm run dev | Vercel: Environment Variables

# ─── Email (Brevo) ───
BREVO_API_KEY=
BREVO_FROM_EMAIL=hola@ailensampo.com
ADMIN_EMAIL=hola@ailensampo.com

# ─── Acceso al ERP ───
ERP_PASSWORD=
JWT_SECRET=

# ─── Respaldo en Supabase (requerido para enlace al cliente) ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── URL pública (producción: https://app.ailensampo.com) ───
APP_URL=https://app.ailensampo.com
