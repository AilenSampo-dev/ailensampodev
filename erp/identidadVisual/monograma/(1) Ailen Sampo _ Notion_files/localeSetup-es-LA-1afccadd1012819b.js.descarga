ateBetween.description":"Devuelve el tiempo entre dos fechas. El último argumento, la unidad, puede ser cualquiera de los siguientes: “years” (años), “quarters” (trimestres), “months” (meses), “weeks” (semanas), “days” (días), “hours” (horas), “minutes” (minutos), “seconds” (segundos) o “milliseconds” (milisegundos).","database.formula.function.dateSubtract.description":"Resta de una fecha. El último argumento, la unidad, puede ser cualquiera de los siguientes: “years” (años), “quarters” (trimestres), “months” (meses), “weeks” (semanas), “days” (días), “hours” (horas), “minutes” (minutos), “seconds” (segundos) o “milliseconds” (milisegundos).","database.formula.function.day.description":"Devuelve un número entero correspondiente al día de la semana para la fecha indicada: 0 para el domingo, 1 para el lunes, 2 para el martes y así sucesivamente.","database.formula.function.empty.description":"Comprueba si un valor está vacío.","database.formula.function.end.description":"Devuelve el final de un intervalo de fechas.","database.formula.function.exp.description":"Devuelve E^x, donde x es el argumento y E es la constante de Euler (2,718…), la base del logaritmo natural.","database.formula.function.floor.description":"Devuelve el entero más grande menor o igual que un número.","database.formula.function.format.description":"Formatea su argumento como cadena.","database.formula.function.formatDate.description":"Formatea una fecha con la cadena de formato de hora estándar de Moment.","database.formula.function.fromTimestamp.description":"Devuelve una fecha convertida a partir de una marca de tiempo de Unix en milisegundos, correspondiente al número de milisegundos desde el 1 de enero de 1970.","database.formula.function.hour.description":"Devuelve un número entero, entre 0 y 23, que se corresponde con la hora de la fecha indicada.","database.formula.function.id.description":"Genera un identificador de secuencia único para cada entrada.","database.formula.function.join.description":"Inserta el primer argumento entre el resto y devuelve su concatenación.","database.formula.function.length.description":"Devuelve la longitud de una cadena de caracteres.","database.formula.function.ln.description":"Devuelve el logaritmo natural de un número.","database.formula.function.log10.description":"Devuelve el logaritmo en base 10 de un número.","database.formula.function.log2.description":"Devuelve el logaritmo en base 2 de un número.","database.formula.function.max.description":"Devuelve el mayor de entre cero o más números.","database.formula.function.min.description":"Devuelve el menor de entre cero o más números.","database.formula.function.minute.description":"Devuelve un número entero, entre 0 y 59, que se corresponde con los minutos de la fecha indicada.","database.formula.function.month.description":"Devuelve un número entero, entre 0 y 11, que se corresponde con el mes de la fecha indicada, según la hora local. 0 corresponde a enero, 1 a febrero, etc.","database.formula.function.now.description":"Devuelve la fecha y hora actuales.","database.formula.function.replace.description":"Reemplaza la primera coincidencia de una expresión regular con un nuevo valor.","database.formula.function.replaceAll.description":"Reemplaza todas las coincidencias de una expresión regular con un nuevo valor.","database.formula.function.round.description":"Devuelve el valor de un número redondeado al entero más cercano.","database.formula.function.sign.description":"Devuelve el signo de la x, lo cual indica si x es positivo, negativo o cero.","database.formula.function.slice.description":"Extrae una subcadena de una cadena desde el índice inicial (de forma inclusiva) hasta el índice final (de forma opcional y exclusiva).","database.formula.function.sqrt.description":"Devuelve la raíz cuadrada positiva de un número.","database.formula.function.start.description":"Devuelve el inicio de un intervalo de fechas.","database.formula.function.test.description":"Comprueba si una cadena coincide con una expresión regular.","database.formula.function.timestamp.description":"Devuelve un número entero de una marca de tiempo de Unix en milisegundos, correspondiente al número de milisegundos desde el 1 de enero de 1970.","database.formula.function.toNumber.description":"Analiza un número del texto.","database.formula.function.year.description":"Devuelve un número que se corresponde con el año de la fecha indicada.","database.formula.operator.add.description":"Suma dos números y devuelve su suma, o concatena dos cadenas de caracteres.","database.formula.operator.and.description":"Devuelve el Y lógico de sus dos argumentos.","database.formula.operator.divide.description":"Divide dos números y devuelve su cociente.","database.formula.operator.equal.description":"Devuelve verdadero si sus argumentos son iguales y falso en caso contrario.","database.formula.operator.if.description":"Cambia entre dos opciones tomando otro valor como base.","database.formula.operator.larger.description":"Devuelve verdadero si el primer argumento es mayor que el segundo.","database.formula.operator.largerEq.description":"Devuelve verdadero si el primer argumento es mayor o igual que el segundo.","database.formula.operator.mod.description":"Divide dos números y devuelve el resto.","database.formula.operator.multiply.description":"Multiplica dos números y devuelve su producto.","database.formula.operator.not.description":"Devuelve el NO lógico de su argumento.","database.formula.operator.or.description":"Devuelve el O lógico de sus dos argumentos.","database.formula.operator.pow.description":"Devuelve la base a la potencia del exponente, es decir, baseexponente.","database.formula.operator.smaller.description":"Devuelve verdadero si el primer argumento es menor que el segundo.","database.formula.operator.smallerEq.description":"Devuelve verdadero si el primer argumento es menor o igual que el segundo.","database.formula.operator.subtract.description":"Resta dos números y devuelve su diferencia.","database.formula.operator.unaryMinus.description":"Invierte el signo de un número.","database.formula.operator.unaryPlus.description":"Convierte su argumento en un número.","database.formula.operator.unequal.description":"Devuelve falso si sus argumentos son iguales y verdadero en caso contrario.","database.formula.undoFormulaInput.tooltip":"Deshacer","database.formula2.constant.e.description":"Genera la base del logaritmo natural.","database.formula2.constant.pi.description":"Genera la relación entre la circunferencia de un círculo y su diámetro.","database.formula2.function._wait.description":"Espera la cantidad de tiempo especificada y luego genera el resultado.","database.formula2.function.abs.description":"Genera el valor absoluto del número.","database.formula2.function.cbrt.description":"Genera la raíz cúbica del número.","database.formula2.function.ceil.description":"Genera el número entero más pequeño mayor o igual que el número.","database.formula2.function.concat.description":"Genera la concatenación de múltiples listas.","database.formula2.function.contains.description":"Genera el valor “verdadero” si la cadena de búsqueda se encuentra en el valor.","database.formula2.function.count.description":"Devuelve el número de elementos de una lista que cumplen una condición específica. Si no se indica ninguna condición, muestra el número total de elementos (equivalente a length()).","database.formula2.function.date.description":"Genera el día del mes a partir de una fecha (1-31).","database.formula2.function.dateAdd.description":"Suma tiempo a la fecha. El argumento de la unidad puede ser cualquiera de los siguientes: “years” (años), “quarters” (trimestres), “months” (meses), “weeks” (semanas), “days” (días), “hours” (horas) o “minutes” (minutos).","database.formula2.function.dateBetween.description":"Devuelve la diferencia entre dos fechas. El argumento de la unidad puede ser cualquiera de los siguientes: “years” (años), “quarters” (trimestres), “months” (meses), “weeks” (semanas), “days” (días), “hours” (horas) o “minutes” (minutos).","database.formula2.function.dateEnd.description":"Genera el final del intervalo de fechas.","database.formula2.function.dateRange.description":"Genera un intervalo de fechas a partir de la fecha inicial y final.","database.formula2.function.dateStart.description":"Genera el inicio del intervalo de fechas.","database.formula2.function.dateSubtract.description":"Resta tiempo a la fecha. El argumento de la unidad puede ser cualquiera de los siguientes: “years” (años), “quarters” (trimestres), “months” (meses), “weeks” (semanas), “days” (días), “hours” (horas) o “minutes” (minutos).","database.formula2.function.day.description":"Genera el día de la semana de la fecha, entre 1 (lunes) y 7 (domingo).","database.formula2.function.email.description":"Genera la dirección de correo electrónico de una persona.","database.formula2.function.empty.description":"Devuelve “true” si el valor que proporcionas está vacío. Si no proporcionas ningún argumento, devuelve un valor vacío. Los valores vacíos incluyen 0, ””, false, [] y propiedades en blanco.","database.formula2.function.end.description":"Genera el final del intervalo de fechas.","database.formula2.function.exp.description":"Genera e^x, donde x es el argumento y E es el número de Euler (2,718…), la base del logaritmo natural.","database.formula2.function.floor.description":"Genera el número entero más grande menor o igual que el número.","database.formula2.function.format.description":"Genera el valor en formato de texto.","database.formula2.function.formatDate.description":"Da formato a la fecha utilizando una cadena de formato personalizada y una zona horaria opcional. La cadena de formato puede contener el siguiente texto para representar partes de la fecha: “YYYY” para el año, “MM” para el mes, “DD” para el día, “HH” para la hora y “mm” para los minutos.","database.formula2.function.formatNumber.description":"Devuelve el valor numérico con formato de texto.{br}{br}El argumento de formato puede ser “commas” (comas; el predeterminado), “percent” (porcentaje), “humanize” (humanizar), “bytes_binary” (bytes en binarios), “bytes_decimal” (bytes en decimales) o un código de moneda (consultar a continuación).{br}{br}Si lo deseas, puedes especificar cuántos decimales mostrar (0-12) a través del argumento de precisión.{br}{br}Estos son los códigos de moneda admitidos: “usd”, “aud”, “cad”, “sgd”, “eur”, “gbp”, “jpy”, “rub”, “inr”, “krw”, “cny”, “brl”, “try”, “idr”, “chf”, “hkd”, “nzd”, “sek”, “nok”, “mxn”, “zar”, “twd”, “dkk”, “pln”, “thb”, “huf”, “czk”, “ils”, “clp”, “php”, “aed”, “cop”, “sar”, “myr”, “ron”, “ars”, “uyu”, “pen”, “vnd”, “pkr”, “ngn”.","database.formula2.function.fromTimestamp.description":"Genera la fecha a partir de una marca de tiempo de Unix. La marca de tiempo representa el número de milisegundos transcurridos desde el 1 de enero de 1970. Nota: la fecha generada no conservará los segundos y milisegundos.","database.formula2.function.hour.description":"Genera la hora de la fecha (0-23).","database.formula2.function.id.description":"Genera el ID de la página o persona. Si no se proporciona ninguna página o persona, genera el ID de la página en la que se encuentra la fórmula.","database.formula2.function.join.description":"Genera los valores de la lista con el elemento conector entre cada uno de los valores.","database.formula2.function.length.description":"Genera la longitud del valor de la lista o el texto.","database.formula2.function.link.description":"Crea un enlace a partir de una etiqueta y una URL.","database.formula2.function.ln.description":"Genera el logaritmo natural del número.","database.formula2.function.log10.description":"Genera el logaritmo en base 10 del número.","database.formula2.function.log2.description":"Genera el logaritmo en base 2 del número.","database.formula2.function.lower.description":"Convierte el texto a minúsculas.","database.formula2.function.match.description":"Genera una lista de todas las coincidencias de las expresiones regulares.","database.formula2.function.max.description":"Genera el número más grande de los argumentos.","database.formula2.function.mean.description":"Genera el promedio aritmético de sus argumentos.","database.formula2.function.median.description":"Genera el valor medio de sus argumentos.","database.formula2.function.min.description":"Genera el número más pequeño de los argumentos.","database.formula2.function.minute.description":"Genera el minuto de la fecha (0-59).","database.formula2.function.mode.description":"Genera el valor más frecuente de sus argumentos.","database.formula2.function.month.description":"Genera el mes de la fecha (1-12).","database.formula2.function.name.description":"Genera el nombre de una persona.","database.formula2.function.now.description":"Genera la fecha y hora actuales.","database.formula2.function.padEnd.description":"Genera el texto de relleno con la secuencia de relleno proporcionada al final hasta alcanzar la longitud deseada.","database.formula2.function.padStart.description":"Genera el texto de relleno con la secuencia de relleno proporcionada al principio hasta alcanzar la longitud deseada.","database.formula2.function.parseDate.description":"Genera la fecha analizada en función de la norma ISO 8601.","database.formula2.function.repeat.description":"Repite el texto un número determinado de veces.","database.formula2.function.replace.description":"Reemplaza la primera coincidencia de la expresión regular con el valor de reemplazo.","database.formula2.function.replaceAll.description":"Reemplaza todas las coincidencias de la expresión regular con el valor de reemplazo.","database.formula2.function.round.description":"Genera el valor de un número redondeado al entero más cercano.","database.formula2.function.sign.description":"Genera 1 si el número es positivo, −1 si es negativo y 0 si es cero.","database.formula2.function.slice.description":"Genera la subcadena del texto desde el índice inicial (de forma inclusiva) hasta el índice final (de forma opcional y exclusiva).","database.formula2.function.split.description":"Genera la lista de valores creada al dividir un texto por un separador.","database.formula2.function.sqrt.description":"Genera la raíz cuadrada positiva del número.","database.formula2.function.start.description":"Genera el inicio del intervalo de fechas.","database.formula2.function.style.description":"Agrega estilos y colores al texto. Estilos de formato válidos: “b” (negrita), “u” (subrayado), “i” (cursiva), “c” (código) o “s” (tachado). Colores válidos: “gray” (gris), “brown” (marrón), “orange” (naranja), “yellow” (amarillo,) “green” (verde), “blue” (azul), “purple” (morado), “pink” (rosa) y “red” (rojo). Agrega “_background” a los colores para aplicar colores de fondo.","database.formula2.function.test.description":"Genera el valor “verdadero” si el valor coincide con una expresión regular y “falso” en caso contrario.","database.formula2.function.timestamp.description":"Genera la marca de tiempo de Unix actual, correspondiente al número de milisegundos transcurridos desde el 1 de enero de 1970.","database.formula2.function.today.description":"Genera la fecha actual sin la hora.","database.formula2.function.toNumber.description":"Analiza un número del texto.","database.formula2.function.trim.description":"Elimina los espacios en blanco del principio y el final del texto.","database.formula2.function.unsafeCastArray.description":"Convierte una matriz de tipo desconocido al tipo del parámetro de la segunda matriz","database.formula2.function.unstyle.description":"Elimina los estilos de formato del texto. Si no se especifica un estilo, se eliminarán todos.","database.formula2.function.upper.description":"Convierte el texto a mayúsculas.","database.formula2.function.week.description":"Genera la semana (1-53) del año para la fecha según la norma ISO 8601.","database.formula2.function.year.description":"Genera el año de la fecha.","database.formula2.operator.add.description":"Suma dos números y genera el total.","database.formula2.operator.at.description":"Genera el valor en el índice especificado en una lista.","database.formula2.operator.divide.description":"Genera el cociente de dos números.","database.formula2.operator.equal.description":"Genera el valor “verdadero” si ambos valores son iguales y “falso” en caso contrario.","database.formula2.operator.every.description":"Genera el valor “verdadero” si todos los elementos de la lista se ajustan a la condición dada y “falso” en caso contrario.","database.formula2.operator.filter.description":"Genera los valores de la lista para los que la condición tiene valor “verdadero”.","database.formula2.operator.find.description":"Genera el primer elemento de la lista para el que la condición genera el valor “verdadero”.","database.formula2.operator.findIndex.description":"Genera el índice del primer elemento de la lista para el que la condición es “TRUE”.","database.formula2.operator.first.description":"Genera el primer elemento de la lista.","database.formula2.operator.flat.description":"Simplifica una lista de listas en una sola lista.","database.formula2.operator.if.description":"Genera el primer valor si la condición tiene valor “verdadero”. En caso contrario, genera el segundo valor.","database.formula2.operator.ifs.description":"Genera el valor que corresponde a la primera condición verdadera. Puede usarse como alternativa de varios enunciados IF() anidados.","database.formula2.operator.includes.description":"Genera el valor “verdadero” si la lista contiene el valor determinado y “falso” en caso contrario.","database.formula2.operator.last.description":"Genera el último elemento de la lista.","database.formula2.operator.let.description":"Asigna un valor a una variable y evalúa la expresión con dicha variable.","database.formula2.operator.lets.description":"Asigna valores a distintas variables y evalúa la expresión usando esas variables.","database.formula2.operator.map.description":"Genera una lista de los resultados obtenidos al aplicar la expresión a cada elemento de la lista de entrada.","database.formula2.operator.mod.description":"Genera el resto de la división del primer número por el segundo.","database.formula2.operator.multiply.description":"Genera el producto de dos números.","database.formula2.operator.pow.description":"Genera el resultado de un número base elevado a la potencia del exponente.","database.formula2.operator.reverse.description":"Genera una versión invertida de la lista.","database.formula2.operator.slice.description":"Genera los elementos de la lista desde el índice inicial (de forma inclusiva) hasta el índice final (de forma opcional y exclusiva).","database.formula2.operator.some.description":"Genera el valor “verdadero” si cualquier elemento de la lista se ajusta a la condición dada y “falso” en caso contrario.","database.formula2.operator.sort.description":"Genera una versión ordenada de la lista. También es posible usar una expresión proporcionada para definir el orden.","database.formula2.operator.splice.description":"Elimina un número especificado de elementos de una lista en el startIndex y, de manera opcional, inserta nuevos elementos en esa posición. Si no se proporciona deleteCount, el valor predeterminado es 0.","database.formula2.operator.subtract.description":"Genera la diferencia entre dos números.","database.formula2.operator.sum.description":"Genera la suma de sus argumentos.","database.formula2.operator.toPlainText.description":"Genera la representación en forma de texto sin formato del texto de entrada.","database.formula2.operator.toText.description":"Genera la representación en forma de texto del valor de entrada.","database.formula2.operator.unequal.description":"Genera el valor “falso” si ambos valores son iguales y “verdadero” en caso contrario.","database.formula2.operator.unique.description":"Genera la lista de valores únicos en la lista de entrada.","database.formulaPropertyEntryMenuItem.title":"Documentación","database.genericColumn.name":"Columna {columnNumber}","database.groupExistsAlreadyError.message":"El grupo ya existe.","database.groupMenu.dateGroupBy.day":"Día","database.groupMenu.dateGroupBy.days":"Días","database.groupMenu.dateGroupBy.month":"Mes","database.groupMenu.dateGroupBy.months":"Meses","database.groupMenu.dateGroupBy.relative":"Relativa","database.groupMenu.dateGroupBy.week":"Semana","database.groupMenu.dateGroupBy.weeks":"Semanas","database.groupMenu.dateGroupBy.year":"Año","database.groupMenu.dateGroupBy.years":"Años","database.groupMenu.groupLimitReachedCaption":"Se puede mostrar un máximo de 1 000 grupos","database.groupMenu.groupLimitReachedTitle":"Se alcanzó el límite de grupos","database.groupMenu.groups":"Grupos","database.groupMenu.hideAllGroups":"Ocultar todo","database.groupMenu.hideGroup":"Ocultar grupo","database.groupMenu.noGroups":"No hay grupos para mostrar","database.groupMenu.numberGroupBy.range":"De {start} a {end}","database.groupMenu.numberGroupRange":"Intervalo de grupo","database.groupMenu.numberGroupSize":"Agrupar cada","database.groupMenu.pinGroup":"Fijar grupo","database.groupMenu.pinnedGroups":"Grupos fijados","database.groupMenu.showAllGroups":"Mostrar todo","database.groupMenu.showGroup":"Mostrar grupo","database.groupMenu.statusGroupBy.group":"Grupo","database.groupMenu.statusGroupBy.option":"Opción","database.groupMenu.textGroupBy.alphabetical":"Alfabético","database.groupMenu.textGroupBy.exact":"Exacto","database.groupMenu.unpinGroup":"Desfijar grupo","database.groups.loadMoreButtonBoard":"Cargar más grupos","database.groups.loadMoreButtonDefault":"Cargar más","database.library.propertyTypeName.name":"Nombre","database.library.propertyTypeName.pageName":"Nombre de la página","database.library.propertyTypeName.parent":"Principal","database.library.propertyTypeName.subpages":"Subpáginas","database.loadMoreButtonTitle"