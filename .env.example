# Copiá a .env.local para desarrollo local

# Email (Brevo) — aviso cuando aceptan una propuesta
BREVO_API_KEY=
BREVO_FROM_EMAIL=hola@ailensampo.com
ADMIN_EMAIL=hola@ailensampo.com

# URL pública del sitio
APP_URL=http://localhost:3000

# IA del demo "Generar sistema" (Groq gratis: console.groq.com). Sin key, el demo usa reglas locales.
GROQ_API_KEY=
# Opcional — cambiar de proveedor/modelo sin tocar código (cualquier API compatible con OpenAI)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# Panel interno /app (usuario y contraseña). En producción, si faltan, el panel queda cerrado.
ADMIN_USER=
ADMIN_PASSWORD=

# Base del sitio (Neon). Tablas: db/neon-sitio.sql
DATABASE_URL=
