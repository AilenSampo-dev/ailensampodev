{
  "name": "ailensampo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo: sitio público (raíz) + ERP privado (erp/)",
  "scripts": {
    "dev": "npm run dev:site",
    "dev:site": "npx --yes serve@latest -l 3000 .",
    "start": "npm run dev:site",
    "dev:erp": "npm --prefix erp run dev",
    "build:erp": "npm --prefix erp run build",
    "preview:erp": "npm --prefix erp run preview",
    "install:erp": "npm --prefix erp install",
    "deploy:erp": "npm --prefix erp exec -- npx vercel --prod"
  }
}
